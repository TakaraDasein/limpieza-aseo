---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db';
import { products, categories } from '../../db/schema';
import { eq } from 'drizzle-orm';

// Fetch statistics
const allProducts = await db.select().from(products).all();
const allCategories = await db.select().from(categories).all();

const totalProducts = allProducts.length;
const activeProducts = allProducts.filter(p => p.active).length;
const totalCategories = allCategories.length;
---

<AdminLayout title="Dashboard | Admin Panel">
  <div class="p-6 lg:p-8">
    <!-- Welcome Card -->
    <div class="bg-gradient-to-br from-primary to-primary-container rounded-3xl p-8 mb-8 shadow-lg">
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-on-primary" style="font-size: 48px;">
          waving_hand
        </span>
        <div>
          <h2 class="text-3xl font-display font-bold text-on-primary mb-2">
            Panel de Administración
          </h2>
          <p class="text-lg text-on-primary opacity-90">
            Bienvenido al panel de control de Mister LyA
          </p>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Products -->
      <div class="bg-surface rounded-2xl p-6 border border-outline-variant hover:shadow-lg transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="bg-secondary-container rounded-xl p-3">
            <span class="material-symbols-outlined text-on-secondary-container text-2xl">
              inventory_2
            </span>
          </div>
          <div class="text-right">
            <p class="text-sm text-on-surface-variant mb-1">Total</p>
            <p class="text-3xl font-display font-bold text-on-surface">{totalProducts}</p>
          </div>
        </div>
        <h3 class="text-sm font-semibold text-on-surface-variant">Productos Totales</h3>
      </div>

      <!-- Active Products -->
      <div class="bg-surface rounded-2xl p-6 border border-outline-variant hover:shadow-lg transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="bg-tertiary-container rounded-xl p-3">
            <span class="material-symbols-outlined text-on-tertiary-container text-2xl">
              check_circle
            </span>
          </div>
          <div class="text-right">
            <p class="text-sm text-on-surface-variant mb-1">Activos</p>
            <p class="text-3xl font-display font-bold text-on-surface">{activeProducts}</p>
          </div>
        </div>
        <h3 class="text-sm font-semibold text-on-surface-variant">Productos Activos</h3>
      </div>

      <!-- Total Categories -->
      <div class="bg-surface rounded-2xl p-6 border border-outline-variant hover:shadow-lg transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="bg-primary-container rounded-xl p-3">
            <span class="material-symbols-outlined text-on-primary-container text-2xl">
              category
            </span>
          </div>
          <div class="text-right">
            <p class="text-sm text-on-surface-variant mb-1">Total</p>
            <p class="text-3xl font-display font-bold text-on-surface">{totalCategories}</p>
          </div>
        </div>
        <h3 class="text-sm font-semibold text-on-surface-variant">Categorías</h3>
      </div>

      <!-- Recent Activity -->
      <div class="bg-surface rounded-2xl p-6 border border-outline-variant hover:shadow-lg transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="bg-error-container rounded-xl p-3">
            <span class="material-symbols-outlined text-on-error-container text-2xl">
              schedule
            </span>
          </div>
          <div class="text-right">
            <p class="text-sm text-on-surface-variant mb-1">Última</p>
            <p class="text-lg font-display font-bold text-on-surface">Hoy</p>
          </div>
        </div>
        <h3 class="text-sm font-semibold text-on-surface-variant">Actividad Reciente</h3>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-surface rounded-3xl p-8 border border-outline-variant">
      <h3 class="text-2xl font-display font-bold text-on-surface mb-6">
        Acciones Rápidas
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a
          href="/admin/products"
          class="p-6 bg-secondary-container/20 border border-secondary-container rounded-2xl hover:shadow-lg hover:bg-secondary-container/30 transition-all group"
        >
          <span class="material-symbols-outlined text-secondary mb-3 block" style="font-size: 32px;">
            inventory_2
          </span>
          <h4 class="text-xl font-display font-semibold text-on-surface mb-2">
            Ver Productos
          </h4>
          <p class="text-sm text-on-surface-variant">
            Gestionar el catálogo completo de productos
          </p>
        </a>
        
        <a
          href="/admin/categories"
          class="p-6 bg-primary-container/20 border border-primary-container rounded-2xl hover:shadow-lg hover:bg-primary-container/30 transition-all group"
        >
          <span class="material-symbols-outlined text-primary mb-3 block" style="font-size: 32px;">
            category
          </span>
          <h4 class="text-xl font-display font-semibold text-on-surface mb-2">
            Ver Categorías
          </h4>
          <p class="text-sm text-on-surface-variant">
            Organizar las categorías de productos
          </p>
        </a>

        <a
          href="/admin/products/new"
          class="p-6 bg-tertiary-container/20 border border-tertiary-container rounded-2xl hover:shadow-lg hover:bg-tertiary-container/30 transition-all group"
        >
          <span class="material-symbols-outlined text-tertiary mb-3 block" style="font-size: 32px;">
            add_circle
          </span>
          <h4 class="text-xl font-display font-semibold text-on-surface mb-2">
            Nuevo Producto
          </h4>
          <p class="text-sm text-on-surface-variant">
            Agregar un producto nuevo al catálogo
          </p>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
