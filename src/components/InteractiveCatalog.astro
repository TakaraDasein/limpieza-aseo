---
interface Props {
	products: any[];
	categories: any[];
}

const { products, categories } = Astro.props;

// Define background colors for each category
const categoryColors: Record<string, string> = {
  escobas: 'from-blue-50 via-blue-100 to-blue-50',
  cepillos: 'from-purple-50 via-purple-100 to-purple-50',
  traperos: 'from-green-50 via-green-100 to-green-50',
  jabones: 'from-cyan-50 via-cyan-100 to-cyan-50',
  esponjas: 'from-yellow-50 via-yellow-100 to-yellow-50',
  varios: 'from-pink-50 via-pink-100 to-pink-50'
};
---

<section 
  class="py-16 transition-all duration-700 bg-gradient-to-br from-surface via-surface-container-low to-surface" 
  id="products-section"
  data-active-category=""
>
  <div class="max-w-screen-2xl mx-auto px-6 md:px-12">
    
    <!-- Search and Price Filter -->
    <div class="mb-12 max-w-2xl mx-auto">
      <!-- Search Bar -->
      <div class="relative bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
        <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
          <span class="material-symbols-outlined text-2xl text-on-surface-variant">search</span>
        </div>
        <input
          type="text"
          id="product-search"
          placeholder="Buscar productos por nombre..."
          class="w-full pl-16 pr-16 py-5 text-lg bg-transparent focus:outline-none focus:ring-0 text-on-surface placeholder-on-surface-variant"
        />
        <button
          id="clear-search"
          class="absolute inset-y-0 right-0 pr-6 flex items-center opacity-0 pointer-events-none transition-opacity duration-200"
          aria-label="Limpiar búsqueda"
        >
          <span class="material-symbols-outlined text-2xl text-on-surface-variant hover:text-primary transition-colors cursor-pointer">close</span>
        </button>
      </div>
      
      <!-- Price Range Filter -->
      <div class="mt-4 bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-2xl text-on-surface-variant">payments</span>
            <h3 class="font-semibold text-on-surface">Rango de Precio</h3>
          </div>
          <button
            id="clear-price"
            class="text-sm text-primary hover:text-secondary transition-colors font-medium opacity-0 pointer-events-none"
            aria-label="Limpiar filtro de precio"
          >
            Limpiar
          </button>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <!-- Min Price Input -->
          <div class="relative">
            <label for="min-price" class="text-xs font-semibold text-on-surface-variant mb-2 block">Precio Mínimo</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-on-surface-variant pointer-events-none">$</span>
              <input
                type="number"
                id="min-price"
                placeholder="0"
                min="0"
                step="1000"
                class="w-full pl-8 pr-4 py-3 border-2 border-surface-container rounded-xl focus:border-primary focus:outline-none text-on-surface transition-all"
              />
            </div>
          </div>
          
          <!-- Max Price Input -->
          <div class="relative">
            <label for="max-price" class="text-xs font-semibold text-on-surface-variant mb-2 block">Precio Máximo</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-on-surface-variant pointer-events-none">$</span>
              <input
                type="number"
                id="max-price"
                placeholder="∞"
                min="0"
                step="1000"
                class="w-full pl-8 pr-4 py-3 border-2 border-surface-container rounded-xl focus:border-primary focus:outline-none text-on-surface transition-all"
              />
            </div>
          </div>
        </div>
        
        <!-- Current Price Range Display -->
        <div id="price-range-display" class="text-sm text-center text-on-surface-variant opacity-0 transition-opacity duration-200 py-2 px-4 bg-surface-container rounded-lg">
          Filtrando: <span class="font-semibold text-primary" id="price-range-text"></span>
        </div>
      </div>
      
      <div id="search-results-info" class="mt-3 text-center text-sm text-on-surface-variant opacity-0 transition-opacity duration-200"></div>
    </div>
    
    <!-- Products by Category -->
    {categories.map((category, index) => {
      const categoryProducts = products.filter(p => p.categoryId === category.id);
      const bgColor = categoryColors[category.id] || 'from-gray-50 via-gray-100 to-gray-50';
      
      return (
        <div 
          class="category-section mb-20 transition-all duration-500"
          id={`category-${category.id}`}
          data-category={category.id}
          style="display: none;"
        >
          <!-- Category Header with animated background -->
          <div class={`relative rounded-3xl p-8 md:p-12 mb-10 overflow-hidden bg-gradient-to-br ${bgColor}`}>
            <div class="absolute inset-0 opacity-10">
              <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full blur-3xl"></div>
              <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary rounded-full blur-3xl"></div>
            </div>
            
            <div class="relative z-10 flex items-center gap-6">
              <div class="w-20 h-20 md:w-24 md:h-24 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                <span class="material-symbols-outlined text-5xl md:text-6xl text-primary">{category.icon}</span>
              </div>
              <div>
                <h2 class="font-headline text-3xl md:text-5xl font-bold text-primary tracking-tight mb-2">
                  {category.name}
                </h2>
                <p class="text-on-surface-variant text-lg">{category.description}</p>
              </div>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {categoryProducts.map((product, prodIndex) => (
              <div 
                class="product-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 group"
                style={`animation-delay: ${prodIndex * 50}ms;`}
                data-product-name={product.name.toLowerCase()}
                data-product-description={product.description.toLowerCase()}
                data-product-price={product.price}
              >
                <div class="aspect-square overflow-hidden bg-surface-container-highest relative">
                  <img 
                    src={product.image} 
                    alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                
                <div class="p-6">
                  <h4 class="font-headline font-bold text-lg text-primary mb-2 line-clamp-2 group-hover:text-secondary transition-colors">
                    {product.name}
                  </h4>
                  <p class="text-sm text-on-surface-variant mb-4 line-clamp-3">
                    {product.description}
                  </p>
                  
                  {product.variants && product.variants.length > 0 && (
                    <div class="mb-4">
                      <p class="text-xs font-semibold text-secondary mb-2">Variantes disponibles:</p>
                      <div class="flex flex-wrap gap-2">
                        {product.variants.map(variant => (
                          <span class="text-xs px-3 py-1 bg-surface-container rounded-full text-on-surface-variant">
                            {variant}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                  
                  {product.price && (
                    <div class="mb-3">
                      <p class="text-lg font-bold text-primary">
                        ${(product.price / 1000).toFixed(3).replace('.', ',')} COP
                      </p>
                    </div>
                  )}
                  
                  <!-- Quantity Selector -->
                  <div class="mb-4">
                    <label class="text-xs font-semibold text-on-surface-variant mb-2 block">Cantidad:</label>
                    <div class="flex items-center gap-3">
                      <button 
                        class="quantity-btn-minus w-10 h-10 bg-surface-container rounded-lg font-bold text-primary hover:bg-surface-container-high transition-all flex items-center justify-center"
                        data-product-id={product.id}
                      >
                        <span class="material-symbols-outlined text-xl">remove</span>
                      </button>
                      <input 
                        type="number" 
                        min="1" 
                        value="1" 
                        class="quantity-input w-16 h-10 text-center border-2 border-surface-container rounded-lg font-bold text-primary focus:border-primary focus:outline-none"
                        data-product-id={product.id}
                      />
                      <button 
                        class="quantity-btn-plus w-10 h-10 bg-surface-container rounded-lg font-bold text-primary hover:bg-surface-container-high transition-all flex items-center justify-center"
                        data-product-id={product.id}
                      >
                        <span class="material-symbols-outlined text-xl">add</span>
                      </button>
                    </div>
                  </div>
                  
                  <button 
                    class="whatsapp-btn w-full bg-primary text-on-primary py-3 rounded-xl font-bold hover:bg-primary-container hover:scale-95 transition-all flex items-center justify-center gap-2 group-hover:shadow-lg"
                    data-product-id={product.id}
                    data-product-name={product.name}
                    data-product-sku={product.sku}
                    data-product-price={product.price}
                  >
                    <span>Consultar por WhatsApp</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  // Reset product card animations when category changes
  document.addEventListener('DOMContentLoaded', () => {
    // Remove fade-in class from all products initially
    document.querySelectorAll('.product-card').forEach(card => {
      card.classList.remove('fade-in-up');
    });

    // Search and filter functionality
    const searchInput = document.getElementById('product-search') as HTMLInputElement;
    const clearButton = document.getElementById('clear-search') as HTMLButtonElement;
    const searchResultsInfo = document.getElementById('search-results-info') as HTMLDivElement;
    const minPriceInput = document.getElementById('min-price') as HTMLInputElement;
    const maxPriceInput = document.getElementById('max-price') as HTMLInputElement;
    const clearPriceButton = document.getElementById('clear-price') as HTMLButtonElement;
    const priceRangeDisplay = document.getElementById('price-range-display') as HTMLDivElement;
    const priceRangeText = document.getElementById('price-range-text') as HTMLSpanElement;
    let currentCategory = '';

    // Format price in COP
    function formatPrice(price: number): string {
      return `$${(price / 1000).toFixed(3).replace('.', ',')} COP`;
    }

    // Get current active category
    function getCurrentCategory(): string {
      const activeSection = document.querySelector('.category-section[style*="display: block"]');
      return activeSection ? activeSection.getAttribute('data-category') || '' : '';
    }

    // Update price range display
    function updatePriceRangeDisplay(minPrice: number | null, maxPrice: number | null) {
      if (minPrice === null && maxPrice === null) {
        priceRangeDisplay.style.opacity = '0';
        clearPriceButton.style.opacity = '0';
        clearPriceButton.classList.add('pointer-events-none');
        return;
      }

      let rangeText = '';
      if (minPrice !== null && maxPrice !== null) {
        rangeText = `${formatPrice(minPrice)} - ${formatPrice(maxPrice)}`;
      } else if (minPrice !== null) {
        rangeText = `Desde ${formatPrice(minPrice)}`;
      } else if (maxPrice !== null) {
        rangeText = `Hasta ${formatPrice(maxPrice)}`;
      }

      priceRangeText.textContent = rangeText;
      priceRangeDisplay.style.opacity = '1';
      clearPriceButton.style.opacity = '1';
      clearPriceButton.classList.remove('pointer-events-none');
    }

    // Filter products based on search term and price range
    function filterProducts(searchTerm: string, minPrice: number | null, maxPrice: number | null) {
      const normalizedSearch = searchTerm.toLowerCase().trim();
      currentCategory = getCurrentCategory();
      
      const currentSection = document.querySelector(`.category-section[data-category="${currentCategory}"]`);
      if (!currentSection) return;

      const productCards = currentSection.querySelectorAll('.product-card');
      let visibleCount = 0;
      let totalCount = productCards.length;

      productCards.forEach((card) => {
        const productName = card.getAttribute('data-product-name') || '';
        const productDescription = card.getAttribute('data-product-description') || '';
        const productPrice = parseFloat(card.getAttribute('data-product-price') || '0');
        
        // Check if search term matches name or description
        const searchMatches = normalizedSearch === '' || 
                       productName.includes(normalizedSearch) || 
                       productDescription.includes(normalizedSearch);

        // Check if price is within range
        const priceMatches = (minPrice === null || productPrice >= minPrice) &&
                            (maxPrice === null || productPrice <= maxPrice);

        if (searchMatches && priceMatches) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Update search results info
      const hasFilters = normalizedSearch !== '' || minPrice !== null || maxPrice !== null;
      if (hasFilters) {
        searchResultsInfo.textContent = `${visibleCount} de ${totalCount} productos encontrados`;
        searchResultsInfo.style.opacity = '1';
      } else {
        searchResultsInfo.style.opacity = '0';
      }

      // Show/hide clear search button
      if (normalizedSearch !== '') {
        clearButton.style.opacity = '1';
        clearButton.classList.remove('pointer-events-none');
      } else {
        clearButton.style.opacity = '0';
        clearButton.classList.add('pointer-events-none');
      }

      // Update price range display
      updatePriceRangeDisplay(minPrice, maxPrice);
    }

    // Get current filter values and apply
    function applyFilters() {
      const searchTerm = searchInput?.value || '';
      const minPrice = minPriceInput?.value ? parseFloat(minPriceInput.value) : null;
      const maxPrice = maxPriceInput?.value ? parseFloat(maxPriceInput.value) : null;
      filterProducts(searchTerm, minPrice, maxPrice);
    }

    // Search input event listener
    searchInput?.addEventListener('input', () => {
      applyFilters();
    });

    // Price input event listeners
    minPriceInput?.addEventListener('input', () => {
      applyFilters();
    });

    maxPriceInput?.addEventListener('input', () => {
      applyFilters();
    });

    // Clear search button
    clearButton?.addEventListener('click', () => {
      searchInput.value = '';
      applyFilters();
      searchInput.focus();
    });

    // Clear price filter button
    clearPriceButton?.addEventListener('click', () => {
      minPriceInput.value = '';
      maxPriceInput.value = '';
      applyFilters();
    });

    // Re-apply search filter when category changes
    const observer = new MutationObserver(() => {
      const newCategory = getCurrentCategory();
      if (newCategory !== currentCategory) {
        currentCategory = newCategory;
        applyFilters();
      }
    });

    // Observe changes to category sections display
    document.querySelectorAll('.category-section').forEach(section => {
      observer.observe(section, { attributes: true, attributeFilter: ['style'] });
    });

    // Quantity selector functionality
    document.querySelectorAll('.quantity-btn-minus').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 1;
          if (currentValue > 1) {
            input.value = (currentValue - 1).toString();
          }
        }
      });
    });

    document.querySelectorAll('.quantity-btn-plus').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 1;
          input.value = (currentValue + 1).toString();
        }
      });
    });

    // WhatsApp button functionality
    document.querySelectorAll('.whatsapp-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const productName = btn.getAttribute('data-product-name');
        const productSku = btn.getAttribute('data-product-sku');
        const productPrice = btn.getAttribute('data-product-price');
        
        // Get quantity
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        const quantity = input ? parseInt(input.value) || 1 : 1;
        
        // Format price
        const priceFormatted = productPrice ? `$${(parseInt(productPrice) / 1000).toFixed(3).replace('.', ',')} COP` : 'Consultar';
        
        // Build WhatsApp message
        let message = `¡Hola! Me interesa: ${productName}`;
        
        if (productSku) {
          message += ` (SKU: ${productSku})`;
        }
        
        message += ` - Cantidad: ${quantity} unidad${quantity > 1 ? 'es' : ''}`;
        
        if (productPrice) {
          message += ` - Precio unitario: ${priceFormatted}`;
        }
        
        // Open WhatsApp
        const whatsappUrl = `https://wa.me/573115412230?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .product-card {
    opacity: 0;
    transform: translateY(20px);
  }
  
  .product-card.fade-in-up {
    animation: fadeInUp 0.5s ease-out forwards;
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Dynamic backgrounds based on active category */
  #products-section[data-active-category="escobas"] {
    background: linear-gradient(to bottom right, rgba(239, 246, 255, 0.5), var(--color-surface), rgba(239, 246, 255, 0.5));
  }
  
  #products-section[data-active-category="cepillos"] {
    background: linear-gradient(to bottom right, rgba(250, 245, 255, 0.5), var(--color-surface), rgba(250, 245, 255, 0.5));
  }
  
  #products-section[data-active-category="traperos"] {
    background: linear-gradient(to bottom right, rgba(240, 253, 244, 0.5), var(--color-surface), rgba(240, 253, 244, 0.5));
  }
  
  #products-section[data-active-category="jabones"] {
    background: linear-gradient(to bottom right, rgba(236, 254, 255, 0.5), var(--color-surface), rgba(236, 254, 255, 0.5));
  }
  
  #products-section[data-active-category="esponjas"] {
    background: linear-gradient(to bottom right, rgba(254, 252, 232, 0.5), var(--color-surface), rgba(254, 252, 232, 0.5));
  }
  
  #products-section[data-active-category="varios"] {
    background: linear-gradient(to bottom right, rgba(253, 242, 248, 0.5), var(--color-surface), rgba(253, 242, 248, 0.5));
  }
</style>
