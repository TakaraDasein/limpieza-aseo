---
interface Props {
	products: any[];
	categories: any[];
}

const { products, categories } = Astro.props;

// Define background colors for each category
const categoryColors: Record<string, string> = {
  escobas: 'from-blue-50 via-blue-100 to-blue-50',
  cepillos: 'from-purple-50 via-purple-100 to-purple-50',
  traperos: 'from-green-50 via-green-100 to-green-50',
  jabones: 'from-cyan-50 via-cyan-100 to-cyan-50',
  esponjas: 'from-yellow-50 via-yellow-100 to-yellow-50',
  varios: 'from-pink-50 via-pink-100 to-pink-50'
};
---

<!-- Hero Section with Title, Filters, and Categories -->
<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary via-primary-container to-secondary">
  <!-- Animated background shapes -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-20 left-10 w-72 h-72 bg-secondary-fixed/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-primary-fixed/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>
  
  <div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-16 md:py-20 relative z-10 w-full">
    <!-- Title and Description -->
    <div class="text-center mb-12">
      <h1 class="font-headline text-5xl md:text-7xl font-extrabold text-white mb-6 tracking-tighter">
        Nuestro Catálogo
      </h1>
      <p class="text-white/90 text-lg md:text-xl max-w-2xl mx-auto mb-8">
        Explora nuestra colección completa de productos de limpieza profesional. Filtra por categoría o busca directamente lo que necesitas.
      </p>
    </div>

    <!-- Filters Container -->
    <div class="max-w-5xl mx-auto bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl p-6 md:p-8 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        
        <!-- Search Bar -->
        <div class="relative">
          <label for="product-search" class="text-xs font-bold text-on-surface-variant mb-2 block uppercase tracking-wide">
            Buscar Producto
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-xl text-on-surface-variant">search</span>
            </div>
            <input
              type="text"
              id="product-search"
              placeholder="Nombre del producto..."
              class="w-full pl-12 pr-12 py-3.5 bg-surface-container rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-on-surface placeholder-on-surface-variant transition-all"
            />
            <button
              id="clear-search"
              class="absolute inset-y-0 right-0 pr-4 flex items-center opacity-0 pointer-events-none transition-opacity duration-200"
              aria-label="Limpiar búsqueda"
            >
              <span class="material-symbols-outlined text-xl text-on-surface-variant hover:text-primary transition-colors cursor-pointer">close</span>
            </button>
          </div>
        </div>
        
        <!-- Category Dropdown -->
        <div class="relative">
          <label for="category-filter" class="text-xs font-bold text-on-surface-variant mb-2 block uppercase tracking-wide">
            Filtrar por Categoría
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-xl text-on-surface-variant">category</span>
            </div>
            <select
              id="category-filter"
              class="w-full pl-12 pr-10 py-3.5 bg-surface-container rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-on-surface appearance-none cursor-pointer transition-all"
            >
              <option value="">Todas las categorías</option>
              {categories.map(category => (
                <option value={category.id}>{category.name}</option>
              ))}
            </select>
            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-xl text-on-surface-variant">expand_more</span>
            </div>
          </div>
        </div>
        
      </div>
      
      <!-- Results Info -->
      <div id="search-results-info" class="text-center transition-all duration-200 opacity-0">
        <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-full">
          <span class="material-symbols-outlined text-sm">filter_alt</span>
          <span class="font-semibold text-sm" id="results-text"></span>
        </div>
      </div>
      
      <!-- Active Filters -->
      <div id="active-filters" class="mt-4 flex flex-wrap gap-2 justify-center opacity-0 transition-opacity duration-200">
        <button
          id="clear-all-filters"
          class="inline-flex items-center gap-1 bg-red-50 text-red-600 px-3 py-1.5 rounded-full text-sm font-semibold hover:bg-red-100 transition-colors"
        >
          <span class="material-symbols-outlined text-sm">close</span>
          <span>Limpiar filtros</span>
        </button>
      </div>
    </div>

    <!-- Category Visual Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
      {categories.map((category) => (
        <button 
          class="category-card group relative p-4 md:p-6 bg-white/95 backdrop-blur-sm rounded-2xl border-2 border-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
          data-category={category.id}
        >
          <div class="flex flex-col items-center gap-3">
            <div class="w-12 h-12 md:w-16 md:h-16 bg-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <span class="material-symbols-outlined text-3xl md:text-4xl text-primary">{category.icon}</span>
            </div>
            <h3 class="font-bold text-xs md:text-sm text-primary text-center group-hover:scale-105 transition-transform leading-tight">
              {category.name}
            </h3>
          </div>
          
          <!-- Selection indicator -->
          <div class="category-indicator absolute -top-1 -right-1 w-6 h-6 bg-primary rounded-full flex items-center justify-center opacity-0 scale-0 transition-all duration-300">
            <span class="material-symbols-outlined text-white text-sm">check</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>
<!-- Products Section -->
<section 
  class="py-16 transition-all duration-700 bg-gradient-to-br from-surface via-surface-container-low to-surface" 
  id="products-section"
  data-active-category=""
>
  <div class="max-w-screen-2xl mx-auto px-6 md:px-12">
    
    <!-- Products by Category -->
    {categories.map((category, index) => {
      const categoryProducts = products.filter(p => p.categoryId === category.id);
      const bgColor = categoryColors[category.id] || 'from-gray-50 via-gray-100 to-gray-50';
      
      return (
        <div 
          class="category-section mb-20 transition-all duration-500"
          id={`category-${category.id}`}
          data-category={category.id}
        >
          <!-- Category Header with animated background -->
          <div class={`relative rounded-3xl p-8 md:p-12 mb-10 overflow-hidden bg-gradient-to-br ${bgColor}`}>
            <div class="absolute inset-0 opacity-10">
              <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full blur-3xl"></div>
              <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary rounded-full blur-3xl"></div>
            </div>
            
            <div class="relative z-10 flex items-center gap-6">
              <div class="w-20 h-20 md:w-24 md:h-24 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                <span class="material-symbols-outlined text-5xl md:text-6xl text-primary">{category.icon}</span>
              </div>
              <div>
                <h2 class="font-headline text-3xl md:text-5xl font-bold text-primary tracking-tight mb-2">
                  {category.name}
                </h2>
                <p class="text-on-surface-variant text-lg">{category.description}</p>
              </div>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {categoryProducts.map((product, prodIndex) => (
              <div 
                class="product-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 group"
                style={`animation-delay: ${prodIndex * 50}ms;`}
                data-product-name={product.name.toLowerCase()}
                data-product-description={product.description.toLowerCase()}
                data-product-price={product.price}
              >
                <div class="aspect-square overflow-hidden bg-surface-container-highest relative">
                  <img 
                    src={product.image} 
                    alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                
                <div class="p-6">
                  <h4 class="font-headline font-bold text-lg text-primary mb-2 line-clamp-2 group-hover:text-secondary transition-colors">
                    {product.name}
                  </h4>
                  <p class="text-sm text-on-surface-variant mb-4 line-clamp-3">
                    {product.description}
                  </p>
                  
                  {product.variants && product.variants.length > 0 && (
                    <div class="mb-4">
                      <p class="text-xs font-semibold text-secondary mb-2">Variantes disponibles:</p>
                      <div class="flex flex-wrap gap-2">
                        {product.variants.map(variant => (
                          <span class="text-xs px-3 py-1 bg-surface-container rounded-full text-on-surface-variant">
                            {variant}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                  
                  {product.price && (
                    <div class="mb-3">
                      <p class="text-lg font-bold text-primary">
                        ${(product.price / 1000).toFixed(3).replace('.', ',')} COP
                      </p>
                    </div>
                  )}
                  
                  <!-- Quantity Selector -->
                  <div class="mb-4">
                    <label class="text-xs font-semibold text-on-surface-variant mb-2 block">Cantidad:</label>
                    <div class="flex items-center gap-3">
                      <button 
                        class="quantity-btn-minus w-10 h-10 bg-surface-container rounded-lg font-bold text-primary hover:bg-surface-container-high transition-all flex items-center justify-center"
                        data-product-id={product.id}
                      >
                        <span class="material-symbols-outlined text-xl">remove</span>
                      </button>
                      <input 
                        type="number" 
                        min="1" 
                        value="1" 
                        class="quantity-input w-16 h-10 text-center border-2 border-surface-container rounded-lg font-bold text-primary focus:border-primary focus:outline-none"
                        data-product-id={product.id}
                      />
                      <button 
                        class="quantity-btn-plus w-10 h-10 bg-surface-container rounded-lg font-bold text-primary hover:bg-surface-container-high transition-all flex items-center justify-center"
                        data-product-id={product.id}
                      >
                        <span class="material-symbols-outlined text-xl">add</span>
                      </button>
                    </div>
                  </div>
                  
                  <button 
                    class="whatsapp-btn w-full bg-primary text-on-primary py-3 rounded-xl font-bold hover:bg-primary-container hover:scale-95 transition-all flex items-center justify-center gap-2 group-hover:shadow-lg"
                    data-product-id={product.id}
                    data-product-name={product.name}
                    data-product-sku={product.sku}
                    data-product-price={product.price}
                  >
                    <span>Consultar por WhatsApp</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Elements
    const searchInput = document.getElementById('product-search') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search') as HTMLButtonElement;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
    const searchResultsInfo = document.getElementById('search-results-info') as HTMLDivElement;
    const resultsText = document.getElementById('results-text') as HTMLSpanElement;
    const activeFilters = document.getElementById('active-filters') as HTMLDivElement;
    const clearAllBtn = document.getElementById('clear-all-filters') as HTMLButtonElement;
    const categorySections = document.querySelectorAll('.category-section');
    const categoryCards = document.querySelectorAll('.category-card');

    let currentSearchTerm = '';
    let currentCategory = '';

    // Update visible categories based on filters
    function updateCategoryVisibility() {
      let totalVisible = 0;
      let totalProducts = 0;

      categorySections.forEach(section => {
        const sectionElement = section as HTMLElement;
        const categoryId = section.getAttribute('data-category') || '';
        const productCards = section.querySelectorAll('.product-card');
        
        // Check if this category should be visible
        const categoryMatches = !currentCategory || categoryId === currentCategory;
        
        if (categoryMatches) {
          let visibleInCategory = 0;
          
          productCards.forEach(card => {
            const cardElement = card as HTMLElement;
            const productName = card.getAttribute('data-product-name') || '';
            const productDescription = card.getAttribute('data-product-description') || '';
            
            // Check if search term matches
            const searchMatches = !currentSearchTerm || 
                                productName.includes(currentSearchTerm) || 
                                productDescription.includes(currentSearchTerm);
            
            if (searchMatches) {
              cardElement.style.display = '';
              visibleInCategory++;
              totalVisible++;
            } else {
              cardElement.style.display = 'none';
            }
            
            totalProducts++;
          });
          
          // Show/hide category section based on visible products
          if (visibleInCategory > 0) {
            sectionElement.style.display = 'block';
            // Add fade-in animation to visible cards
            setTimeout(() => {
              section.querySelectorAll('.product-card[style*="display: block"], .product-card:not([style*="display: none"])').forEach((card, index) => {
                const cardElement = card as HTMLElement;
                cardElement.style.opacity = '0';
                cardElement.style.transform = 'translateY(20px)';
                setTimeout(() => {
                  cardElement.style.transition = 'all 0.5s ease-out';
                  cardElement.style.opacity = '1';
                  cardElement.style.transform = 'translateY(0)';
                }, index * 50);
              });
            }, 100);
          } else {
            sectionElement.style.display = 'none';
          }
        } else {
          sectionElement.style.display = 'none';
        }
      });

      // Update results info
      const hasFilters = currentSearchTerm || currentCategory;
      if (hasFilters) {
        resultsText.textContent = `${totalVisible} productos encontrados`;
        searchResultsInfo.style.opacity = '1';
        activeFilters.style.opacity = '1';
      } else {
        searchResultsInfo.style.opacity = '0';
        activeFilters.style.opacity = '0';
      }

      // Update clear search button visibility
      if (currentSearchTerm) {
        clearSearchBtn.style.opacity = '1';
        clearSearchBtn.classList.remove('pointer-events-none');
      } else {
        clearSearchBtn.style.opacity = '0';
        clearSearchBtn.classList.add('pointer-events-none');
      }
      
      // Update visual category cards
      updateCategoryCards();
    }

    // Update visual category card states
    function updateCategoryCards() {
      categoryCards.forEach(card => {
        const cardCategoryId = card.getAttribute('data-category');
        const indicator = card.querySelector('.category-indicator') as HTMLElement;
        
        if (currentCategory === cardCategoryId) {
          card.classList.add('active-category');
          if (indicator) {
            indicator.style.opacity = '1';
            indicator.style.transform = 'scale(1)';
          }
        } else {
          card.classList.remove('active-category');
          if (indicator) {
            indicator.style.opacity = '0';
            indicator.style.transform = 'scale(0)';
          }
        }
      });
    }

    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      currentSearchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      updateCategoryVisibility();
    });

    // Category filter dropdown handler
    categoryFilter?.addEventListener('change', (e) => {
      currentCategory = (e.target as HTMLSelectElement).value;
      updateCategoryVisibility();
    });

    // Category card click handler
    categoryCards.forEach(card => {
      card.addEventListener('click', () => {
        const categoryId = card.getAttribute('data-category') || '';
        
        if (currentCategory === categoryId) {
          // Deselect if clicking the same category
          currentCategory = '';
          categoryFilter.value = '';
        } else {
          currentCategory = categoryId;
          categoryFilter.value = categoryId;
        }
        
        updateCategoryVisibility();
        
        // Smooth scroll to products section
        const productsSection = document.getElementById('products-section');
        if (productsSection) {
          productsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Clear search button
    clearSearchBtn?.addEventListener('click', () => {
      searchInput.value = '';
      currentSearchTerm = '';
      updateCategoryVisibility();
      searchInput.focus();
    });

    // Clear all filters button
    clearAllBtn?.addEventListener('click', () => {
      searchInput.value = '';
      categoryFilter.value = '';
      currentSearchTerm = '';
      currentCategory = '';
      updateCategoryVisibility();
    });

    // Initial display: show all categories
    categorySections.forEach(section => {
      (section as HTMLElement).style.display = 'block';
    });

    // Quantity selector functionality
    document.querySelectorAll('.quantity-btn-minus').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 1;
          if (currentValue > 1) {
            input.value = (currentValue - 1).toString();
          }
        }
      });
    });

    document.querySelectorAll('.quantity-btn-plus').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        if (input) {
          const currentValue = parseInt(input.value) || 1;
          input.value = (currentValue + 1).toString();
        }
      });
    });

    // WhatsApp button functionality
    document.querySelectorAll('.whatsapp-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const productName = btn.getAttribute('data-product-name');
        const productSku = btn.getAttribute('data-product-sku');
        const productPrice = btn.getAttribute('data-product-price');
        
        // Get quantity
        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`) as HTMLInputElement;
        const quantity = input ? parseInt(input.value) || 1 : 1;
        
        // Format price
        const priceFormatted = productPrice ? `$${(parseInt(productPrice) / 1000).toFixed(3).replace('.', ',')} COP` : 'Consultar';
        
        // Build WhatsApp message
        let message = `¡Hola! Me interesa: ${productName}`;
        
        if (productSku) {
          message += ` (SKU: ${productSku})`;
        }
        
        message += ` - Cantidad: ${quantity} unidad${quantity > 1 ? 'es' : ''}`;
        
        if (productPrice) {
          message += ` - Precio unitario: ${priceFormatted}`;
        }
        
        // Open WhatsApp
        const whatsappUrl = `https://wa.me/573115412230?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Smooth category transitions */
  .category-section {
    animation: fadeIn 0.5s ease-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Active category card styling */
  .category-card.active-category {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border-color: var(--color-primary);
    transform: scale(1.05);
  }
  
  .category-card.active-category h3,
  .category-card.active-category .material-symbols-outlined {
    color: white !important;
  }
  
  .category-card.active-category > div > div {
    background-color: rgba(255, 255, 255, 0.2) !important;
  }
</style>
