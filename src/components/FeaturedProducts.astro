---
import { products as localCatalogProducts } from '../data/catalog';

interface Props {
  products: any[];
  categories: any[];
}

const { products = [], categories = [] } = Astro.props;

const formatPrice = (price: number) => {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    minimumFractionDigits: 0,
  }).format(price || 0);
};

const parseJsonMaybe = (value: unknown, fallback: any) => {
  if (value == null) return fallback;
  if (typeof value === 'string') {
    try {
      return JSON.parse(value);
    } catch {
      return fallback;
    }
  }
  return value;
};

const normalizedProducts = products.map((p) => ({
  ...p,
  variants: parseJsonMaybe(p.variants, null),
  images: [],
}));

const activeProducts = normalizedProducts.filter((p) => p?.active);
const activeCategories = categories.filter((c) =>
  activeProducts.some((p) => p.categoryId === c.id)
);

const getCategoryProducts = (categoryId: string) => {
  return activeProducts
    .filter((p) => p.categoryId === categoryId)
    .sort((a, b) => (a.order || 0) - (b.order || 0));
};

const getProductImage = (product: any) => {
  if (!product) return 'https://via.placeholder.com/800x1000?text=Sin+Imagen';

  // Priority 1: exact image from DB product (Cloudinary or local /public path)
  if (typeof product.image === 'string' && product.image.trim().length > 0) {
    return product.image;
  }

  // Priority 2: additional DB images array if available
  const dbImages = parseJsonMaybe(product.images, []);
  if (Array.isArray(dbImages) && dbImages.length > 0 && typeof dbImages[0] === 'string') {
    return dbImages[0];
  }

  const localBySku = localCatalogProducts.find((p) => p.sku === product.sku);
  if (localBySku?.image) return localBySku.image;

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const productName = typeof product.name === 'string' ? normalize(product.name) : '';
  if (productName) {
    const localByName = localCatalogProducts.find((p) => normalize(p.name) === productName);
    if (localByName?.image) return localByName.image;

    const localBySimilarName = localCatalogProducts.find((p) => {
      const localName = normalize(p.name);
      return localName.includes(productName) || productName.includes(localName);
    });
    if (localBySimilarName?.image) return localBySimilarName.image;
  }

  if (product.categoryId) {
    const localByCategory = localCatalogProducts.find((p) => p.category === product.categoryId);
    if (localByCategory?.image) return localByCategory.image;
  }

  return 'https://via.placeholder.com/800x1000?text=Sin+Imagen';
};

const getFeatures = (product: any) => {
  if (!product) return [];
  if (Array.isArray(product.variants) && product.variants.length > 0) {
    return product.variants
      .map((v: any) => (typeof v === 'string' ? v : v?.name || v?.value || 'Variante'))
      .filter(Boolean)
      .slice(0, 3);
  }
  return [
    'Calidad profesional garantizada.',
    'Rendimiento superior en limpieza.',
    'Producto de alta durabilidad.',
  ];
};

const sections: Array<any> = [];
const maxSections = 3;

if (activeCategories.length > 0) {
  for (let i = 0; i < maxSections; i++) {
    const cat1 = activeCategories[(i * 2) % activeCategories.length] || null;
    const maybeCat2 = activeCategories[(i * 2 + 1) % activeCategories.length] || null;
    const cat2 = maybeCat2 && maybeCat2.id !== cat1?.id ? maybeCat2 : null;

    const cat1Products = cat1 ? getCategoryProducts(cat1.id) : [];
    const cat2Products = cat2 ? getCategoryProducts(cat2.id) : [];

    if (cat1Products.length > 0 || cat2Products.length > 0) {
      sections.push({
        id: `section-${i + 1}`,
        reverse: i % 2 === 1,
        cat1,
        cat2,
        cat1Products,
        cat2Products,
      });
    }
  }
}

const isEmpty = sections.length === 0;
---

<section class="py-0" id="featured-products">
  {isEmpty && (
    <div class="py-20 text-center text-on-surface-variant">
      <h2 class="text-3xl font-bold mb-4">Proximamente</h2>
      <p>Nuestro catalogo se esta actualizando con nuevos productos.</p>
    </div>
  )}

  {!isEmpty &&
    sections.map((section, index) => (
      <div
        class={`group reveal-on-scroll relative flex flex-col ${section.reverse ? 'sm:flex-row-reverse' : 'sm:flex-row'} items-stretch min-h-[520px] md:min-h-[620px] ${index % 2 === 0 ? 'bg-white' : 'bg-surface-container-low'} overflow-hidden border-b border-surface-container-high`}
        data-section={section.id}
        style={`transition-delay: ${index * 120}ms;`}
      >
        <div class="reveal-image w-full sm:w-1/2 h-[260px] sm:h-auto relative overflow-hidden">
          {section.cat1Products.length > 0 && (
            <img
              class={`absolute inset-0 w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700 transform scale-100 group-hover:scale-105 image-cat1-${section.id} opacity-100 z-10`}
              alt={section.cat1Products[0].name}
              src={getProductImage(section.cat1Products[0])}
              loading="lazy"
            />
          )}

          {section.cat2Products.length > 0 && (
            <img
              class={`absolute inset-0 w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700 transform scale-100 group-hover:scale-105 image-cat2-${section.id} opacity-0 z-0`}
              alt={section.cat2Products[0].name}
              src={getProductImage(section.cat2Products[0])}
              loading="lazy"
            />
          )}

          <div class="absolute inset-0 bg-primary/5 z-20 pointer-events-none"></div>
        </div>

        <div class="reveal-content w-full sm:w-1/2 p-5 sm:p-6 md:p-10 lg:p-12 xl:p-14 relative flex flex-col justify-center">
          <div class="max-w-xl mx-auto sm:mx-0 w-full relative min-h-[420px]">
            {section.cat1Products.length > 0 && (
              <div class={`product-content absolute inset-0 transition-opacity duration-500 opacity-100 pointer-events-auto content-cat1-${section.id}`}>
                <div class="h-full flex flex-col justify-center">
                  <span class="text-primary font-bold tracking-[0.2em] md:tracking-[0.25em] lg:tracking-[0.3em] uppercase text-xs md:text-xs lg:text-sm mb-4 md:mb-5 lg:mb-6 block">
                    {section.cat1.name}
                  </span>

                  <h2 class="font-headline text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-extrabold text-primary mb-6 tracking-tighter">
                    {section.cat1Products[0].name}
                  </h2>

                  <p class="text-on-surface-variant text-base lg:text-lg leading-relaxed mb-6 line-clamp-3">
                    {section.cat1Products[0].description || 'Producto de calidad premium para limpieza profesional.'}
                  </p>

                  <div class="space-y-3 mb-6">
                    {getFeatures(section.cat1Products[0]).map((feature: string) => (
                      <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary text-xl flex-shrink-0">check_circle</span>
                        <p class="text-on-surface font-medium text-sm lg:text-base">{feature}</p>
                      </div>
                    ))}
                  </div>

                  <div class="mb-6">
                    <h3 class="text-sm font-bold text-on-surface-variant mb-2">Productos de {section.cat1.name}</h3>
                    <div class="flex flex-wrap gap-2 max-h-24 overflow-auto pr-1">
                      {section.cat1Products.map((product: any) => (
                        <span class="text-xs px-3 py-1 rounded-full bg-surface-container text-on-surface">
                          {product.name}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="mt-auto flex flex-col sm:flex-row items-start sm:items-center justify-between border-t border-surface-container-high pt-5 gap-4">
                    <div class="flex flex-col">
                      <span class="text-on-surface-variant text-xs font-semibold mb-1">Desde</span>
                      <span class="text-3xl font-extrabold text-primary">{formatPrice(section.cat1Products[0].price)}</span>
                    </div>

                    <div class="w-full sm:w-auto flex items-center gap-2 sm:justify-end">
                      {section.cat2 && section.cat2Products.length > 0 && (
                        <div class="inline-flex items-center gap-1 p-1 rounded-md border border-surface-container-high bg-surface-container">
                          <button
                            class={`cat-toggle-btn px-2.5 py-1.5 rounded-md text-[11px] md:text-xs font-semibold transition-all duration-200 cat1-btn-${section.id} bg-primary text-on-primary shadow-sm`}
                            data-target={`cat1-${section.id}`}
                            data-section={section.id}
                          >
                            {section.cat1.name}
                          </button>
                          <button
                            class={`cat-toggle-btn px-2.5 py-1.5 rounded-md text-[11px] md:text-xs font-semibold transition-all duration-200 cat2-btn-${section.id} bg-transparent text-on-surface-variant`}
                            data-target={`cat2-${section.id}`}
                            data-section={section.id}
                          >
                            {section.cat2.name}
                          </button>
                        </div>
                      )}

                      <a
                        class="bg-primary text-on-primary px-4 py-2.5 rounded-lg font-semibold text-xs md:text-sm hover:scale-95 transition-all flex items-center gap-1.5 w-full sm:w-auto justify-center"
                        href={`/catalogo?categoria=${section.cat1.id}`}
                      >
                        Ver en catalogo <span class="material-symbols-outlined text-lg">arrow_forward</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {section.cat2Products.length > 0 && (
              <div class={`product-content absolute inset-0 transition-opacity duration-500 opacity-0 pointer-events-none content-cat2-${section.id}`}>
                <div class="h-full flex flex-col justify-center">
                  <span class="text-primary font-bold tracking-[0.2em] md:tracking-[0.25em] lg:tracking-[0.3em] uppercase text-xs md:text-xs lg:text-sm mb-4 md:mb-5 lg:mb-6 block">
                    {section.cat2.name}
                  </span>

                  <h2 class="font-headline text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-extrabold text-primary mb-6 tracking-tighter">
                    {section.cat2Products[0].name}
                  </h2>

                  <p class="text-on-surface-variant text-base lg:text-lg leading-relaxed mb-6 line-clamp-3">
                    {section.cat2Products[0].description || 'Producto de calidad premium para limpieza profesional.'}
                  </p>

                  <div class="space-y-3 mb-6">
                    {getFeatures(section.cat2Products[0]).map((feature: string) => (
                      <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary text-xl flex-shrink-0">check_circle</span>
                        <p class="text-on-surface font-medium text-sm lg:text-base">{feature}</p>
                      </div>
                    ))}
                  </div>

                  <div class="mb-6">
                    <h3 class="text-sm font-bold text-on-surface-variant mb-2">Productos de {section.cat2.name}</h3>
                    <div class="flex flex-wrap gap-2 max-h-24 overflow-auto pr-1">
                      {section.cat2Products.map((product: any) => (
                        <span class="text-xs px-3 py-1 rounded-full bg-surface-container text-on-surface">
                          {product.name}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="mt-auto flex flex-col sm:flex-row items-start sm:items-center justify-between border-t border-surface-container-high pt-5 gap-4">
                    <div class="flex flex-col">
                      <span class="text-on-surface-variant text-xs font-semibold mb-1">Desde</span>
                      <span class="text-3xl font-extrabold text-primary">{formatPrice(section.cat2Products[0].price)}</span>
                    </div>

                    <div class="w-full sm:w-auto flex items-center gap-2 sm:justify-end">
                      {section.cat2 && section.cat2Products.length > 0 && (
                        <div class="inline-flex items-center gap-1 p-1 rounded-md border border-surface-container-high bg-surface-container">
                          <button
                            class={`cat-toggle-btn px-2.5 py-1.5 rounded-md text-[11px] md:text-xs font-semibold transition-all duration-200 cat1-btn-${section.id} bg-transparent text-on-surface-variant`}
                            data-target={`cat1-${section.id}`}
                            data-section={section.id}
                          >
                            {section.cat1.name}
                          </button>
                          <button
                            class={`cat-toggle-btn px-2.5 py-1.5 rounded-md text-[11px] md:text-xs font-semibold transition-all duration-200 cat2-btn-${section.id} bg-primary text-on-primary shadow-sm`}
                            data-target={`cat2-${section.id}`}
                            data-section={section.id}
                          >
                            {section.cat2.name}
                          </button>
                        </div>
                      )}

                      <a
                        class="bg-primary text-on-primary px-4 py-2.5 rounded-lg font-semibold text-xs md:text-sm hover:scale-95 transition-all flex items-center gap-1.5 w-full sm:w-auto justify-center"
                        href={`/catalogo?categoria=${section.cat2.id}`}
                      >
                        Ver en catalogo <span class="material-symbols-outlined text-lg">arrow_forward</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.cat-toggle-btn');
    const revealSections = document.querySelectorAll('.reveal-on-scroll');

    if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
      revealSections.forEach((section) => {
        section.classList.add('reveal-init');
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -10% 0px' }
      );

      revealSections.forEach((section) => {
        revealObserver.observe(section);
      });
    } else {
      revealSections.forEach((section) => {
        section.classList.remove('reveal-init');
        section.classList.add('is-visible');
      });
    }

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const sectionId = target.getAttribute('data-section');
        const targetCat = target.getAttribute('data-target');

        if (!sectionId || !targetCat) return;

        const isCat1 = targetCat.startsWith('cat1');

        const btn1 = document.querySelector(`.cat1-btn-${sectionId}`);
        const btn2 = document.querySelector(`.cat2-btn-${sectionId}`);

        if (isCat1) {
          btn1?.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
          btn1?.classList.remove('bg-transparent', 'text-on-surface-variant');
          btn2?.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          btn2?.classList.add('bg-transparent', 'text-on-surface-variant');
        } else {
          btn2?.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
          btn2?.classList.remove('bg-transparent', 'text-on-surface-variant');
          btn1?.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          btn1?.classList.add('bg-transparent', 'text-on-surface-variant');
        }

        const content1 = document.querySelector(`.content-cat1-${sectionId}`);
        const content2 = document.querySelector(`.content-cat2-${sectionId}`);
        const img1 = document.querySelector(`.image-cat1-${sectionId}`);
        const img2 = document.querySelector(`.image-cat2-${sectionId}`);

        if (isCat1) {
          content1?.classList.replace('opacity-0', 'opacity-100');
          content1?.classList.replace('pointer-events-none', 'pointer-events-auto');
          content2?.classList.replace('opacity-100', 'opacity-0');
          content2?.classList.replace('pointer-events-auto', 'pointer-events-none');
          img1?.classList.replace('opacity-0', 'opacity-100');
          img1?.classList.replace('z-0', 'z-10');
          img2?.classList.replace('opacity-100', 'opacity-0');
          img2?.classList.replace('z-10', 'z-0');
        } else {
          content2?.classList.replace('opacity-0', 'opacity-100');
          content2?.classList.replace('pointer-events-none', 'pointer-events-auto');
          content1?.classList.replace('opacity-100', 'opacity-0');
          content1?.classList.replace('pointer-events-auto', 'pointer-events-none');
          img2?.classList.replace('opacity-0', 'opacity-100');
          img2?.classList.replace('z-0', 'z-10');
          img1?.classList.replace('opacity-100', 'opacity-0');
          img1?.classList.replace('z-10', 'z-0');
        }
      });
    });
  });
</script>

<style>
  .reveal-on-scroll {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 700ms ease, transform 700ms ease;
    will-change: opacity, transform;
  }

  .reveal-on-scroll .reveal-image,
  .reveal-on-scroll .reveal-content {
    transform: translateX(0);
    transition: transform 850ms ease;
  }

  .reveal-on-scroll.reveal-init {
    opacity: 0;
    transform: translateY(42px);
  }

  .reveal-on-scroll.reveal-init .reveal-image {
    transform: translateX(-24px);
  }

  .reveal-on-scroll.reveal-init .reveal-content {
    transform: translateX(24px);
  }

  .reveal-on-scroll.reveal-init.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-on-scroll.reveal-init.is-visible .reveal-image,
  .reveal-on-scroll.reveal-init.is-visible .reveal-content {
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .reveal-on-scroll.reveal-init .reveal-image,
    .reveal-on-scroll.reveal-init .reveal-content {
      transform: translateY(16px);
    }

    .reveal-on-scroll.reveal-init.is-visible .reveal-image,
    .reveal-on-scroll.reveal-init.is-visible .reveal-content {
      transform: translateY(0);
    }
  }
</style>
