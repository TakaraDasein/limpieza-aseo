---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { products as productsTable, categories as categoriesTable } from '../db/schema';

// Fetch products and categories from database
let products: any[] = [];
let categories: any[] = [];

try {
	const allProducts = await db.select({
		id: productsTable.id,
		sku: productsTable.sku,
		name: productsTable.name,
		description: productsTable.description,
		categoryId: productsTable.categoryId,
		price: productsTable.price,
		image: productsTable.image,
		variants: productsTable.variants,
		active: productsTable.active,
		order: productsTable.order,
	}).from(productsTable).all();
	
	const allCategories = await db.select()
		.from(categoriesTable)
		.orderBy(categoriesTable.order)
		.all();

	products = allProducts
		.filter((p: any) => p.active === true)
		.map((p: any) => ({
			...p,
			variants: p.variants ? JSON.parse(p.variants) : null,
		}));

	categories = allCategories;
} catch (error) {
	console.error('Error fetching data from database:', error);
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo PDF | Mister LyA</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#00377e',
            secondary: '#336b00',
            surface: '#f7f9fb',
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            headline: ['"Manrope"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* CSS rules specifically for native browser print / PDF export */
    body {
      background-color: white;
      color: #191c1e;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    @page {
      size: letter landscape;
      margin: 1.5cm;
    }

    /* Print specific resets */
    @media print {
      .no-print {
        display: none !important;
      }
      
      .page-break {
        page-break-before: always;
        break-before: page;
      }
      
      .avoid-break {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      /* Force 4 columns on print */
      .print-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 1.5rem !important;
      }
      
      .card-border {
        border: 1px solid #e0e3e5 !important;
      }
    }
  </style>
</head>
<body class="bg-white">

  <!-- Interactive top bar that hides when printing -->
  <div class="no-print bg-slate-900 text-white p-4 flex justify-between items-center fixed top-0 w-full z-50 shadow-md">
    <div class="flex items-center gap-4">
      <img src="/logo-h.png" alt="Mister LyA" class="h-10 bg-white p-1 rounded-md" />
      <span class="font-bold">Vista de Impresión Lista</span>
    </div>
    <div class="flex gap-3">
      <button onclick="window.close()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg font-medium transition">Cancelar</button>
      <button onclick="window.print()" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg font-bold flex items-center gap-2 transition shadow-lg">
        <span class="material-symbols-outlined text-sm">print</span>
        Guardar como PDF
      </button>
    </div>
  </div>

  <div class="no-print h-20"></div> <!-- Spacer for fixed header -->

  <main class="w-full max-w-7xl mx-auto p-8">
    
    <!-- Cover Header -->
    <header class="flex items-center justify-between border-b-4 border-primary pb-6 mb-10 avoid-break">
      <div class="flex items-center gap-6">
        <img src="/logo-h.png" alt="Mister LyA" class="h-24 w-auto" />
      </div>
      <div class="text-right">
        <h1 class="text-4xl font-headline font-extrabold text-primary mb-1">Catálogo de Productos</h1>
        <p class="text-lg text-slate-600">Profesionales en Limpieza y Aseo</p>
        <p class="text-sm font-medium text-slate-500 mt-2">Contacto: +57 311 5412230 • misterlya.com</p>
      </div>
    </header>

    <!-- Categories Loop -->
    {categories.map((category, index) => {
      const categoryProducts = products.filter(p => p.categoryId === category.id);
      
      if (categoryProducts.length === 0) return null;

      return (
        <section class={`mb-12 ${index > 0 ? 'page-break' : ''}`}>
          
          <!-- Category Header -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 mb-8 flex items-center gap-6 avoid-break shadow-sm">
            <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center border border-slate-100 shrink-0">
              {category.image ? (
                <img src={category.image} alt={category.name} class="w-12 h-12 object-contain" />
              ) : (
                <span class="material-symbols-outlined text-4xl text-primary">{category.icon}</span>
              )}
            </div>
            <div>
              <h2 class="text-3xl font-headline font-bold text-primary mb-1">{category.name}</h2>
              <p class="text-slate-600 font-medium">{category.description}</p>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 print-grid">
            {categoryProducts.map((product) => (
              <div class="bg-white rounded-xl overflow-hidden card-border avoid-break flex flex-col">
                <div class="aspect-square bg-slate-50 p-4 flex items-center justify-center border-b border-slate-100">
                  {product.image ? (
                    <img src={product.image} alt={product.name} class="max-w-full max-h-full object-contain" />
                  ) : (
                    <span class="material-symbols-outlined text-6xl text-slate-300">inventory_2</span>
                  )}
                </div>
                <div class="p-5 flex flex-col flex-grow">
                  <h3 class="font-headline font-bold text-primary text-base leading-tight mb-2">
                    {product.name}
                  </h3>
                  
                  {product.sku && (
                    <p class="text-xs text-slate-400 mb-2 font-mono">Ref: {product.sku}</p>
                  )}
                  
                  <p class="text-xs text-slate-600 mb-4 line-clamp-3 flex-grow">
                    {product.description}
                  </p>
                  
                  {product.variants && product.variants.length > 0 && (
                    <div class="mb-3">
                      <p class="text-[10px] font-bold text-secondary mb-1">Presentaciones:</p>
                      <div class="flex flex-wrap gap-1">
                        {product.variants.map((v: string) => (
                          <span class="text-[10px] bg-slate-100 px-2 py-0.5 rounded text-slate-700 border border-slate-200">{v}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  
                  {product.price && (
                    <div class="mt-auto pt-3 border-t border-slate-100">
                      <p class="text-lg font-extrabold text-primary">
                        ${(product.price / 1000).toFixed(3).replace('.', ',')} COP
                      </p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
          
        </section>
      );
    })}

  </main>

  <script>
    // Automatically open print dialog when the page is fully loaded and images are ready
    window.addEventListener('load', () => {
      setTimeout(() => {
        window.print();
      }, 500); // slight delay to ensure fonts/images render
    });
  </script>
</body>
</html>