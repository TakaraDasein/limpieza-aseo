---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { categories } from '../../../db/schema';
import { eq } from 'drizzle-orm';

let error = '';
let success = '';

// Handle POST request for CRUD
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');
    
    if (action === 'create' || action === 'update') {
      const originalId = formData.get('originalId')?.toString();
      const inputId = formData.get('id')?.toString().trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
      const name = formData.get('name')?.toString();
      const description = formData.get('description')?.toString() || null;
      const icon = formData.get('icon')?.toString() || 'category';
      const image = formData.get('image')?.toString() || null;
      const order = parseInt(formData.get('order')?.toString() || '0');

      if (!inputId || !name) {
        error = 'El ID y el nombre son obligatorios.';
      } else {
        if (action === 'create') {
          const existing = await db.select().from(categories).where(eq(categories.id, inputId)).get();
          if (existing) {
            error = 'Ya existe una categoría con este ID. Usa un ID diferente.';
          } else {
            await db.insert(categories).values({
              id: inputId,
              name,
              description,
              icon,
              image,
              order
            });
            success = 'Categoría creada con éxito.';
          }
        } else if (action === 'update' && originalId) {
          // If changing ID, we must create new and delete old, or just restrict ID change.
          // For simplicity, we restrict ID change in update. The ID field in the form is readonly.
          await db.update(categories)
            .set({ 
              name, 
              description, 
              icon, 
              image, 
              order, 
              updatedAt: new Date() 
            })
            .where(eq(categories.id, originalId));
          success = 'Categoría actualizada con éxito.';
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        await db.delete(categories).where(eq(categories.id, id));
        success = 'Categoría eliminada con éxito.';
      }
    }
  } catch (e: any) {
    error = 'Error en la operación: ' + e.message;
  }
}

// Fetch all categories
const allCategories = await db.select().from(categories).orderBy(categories.order).all();
---

<AdminLayout title="Categorías | Admin Panel">
  <div class="p-6 lg:p-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-display font-bold text-on-surface mb-2">
          Gestión de Categorías
        </h1>
        <p class="text-on-surface-variant">
          Crea, edita o elimina las categorías del catálogo.
        </p>
      </div>
      <button 
        onclick="document.getElementById('modal-create').classList.remove('hidden')"
        class="bg-primary text-on-primary px-6 py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:scale-95 transition-all shadow-md"
      >
        <span class="material-symbols-outlined text-xl">add</span>
        Nueva Categoría
      </button>
    </div>

    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
        <span class="block sm:inline">{error}</span>
      </div>
    )}
    
    {success && (
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
        <span class="block sm:inline">{success}</span>
      </div>
    )}

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {allCategories.map(category => (
        <div class="bg-surface rounded-2xl p-6 border border-outline-variant shadow-sm hover:shadow-lg transition-all group relative">
          
          <div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button 
              onclick={`openEditModal(${JSON.stringify(category).replace(/"/g, '&quot;')})`}
              class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center hover:bg-primary hover:text-on-primary transition-colors"
              title="Editar"
            >
              <span class="material-symbols-outlined text-sm">edit</span>
            </button>
            <button 
              onclick={`if(confirm('¿Estás seguro de que deseas eliminar la categoría "${category.name}"? Los productos asociados podrían quedar sin categoría.')) document.getElementById('delete-form-${category.id}').submit();`}
              class="w-8 h-8 rounded-full bg-error/10 text-error flex items-center justify-center hover:bg-error hover:text-on-error transition-colors"
              title="Eliminar"
            >
              <span class="material-symbols-outlined text-sm">delete</span>
            </button>
            <form id={`delete-form-${category.id}`} method="POST" class="hidden">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={category.id} />
            </form>
          </div>

          <div class="flex items-start gap-4 mb-4">
            <div class="w-14 h-14 bg-primary-container rounded-xl flex items-center justify-center overflow-hidden shrink-0 border border-primary/10">
              {category.image ? (
                <img src={category.image} alt={category.name} class="w-full h-full object-cover" />
              ) : (
                <span class="material-symbols-outlined text-on-primary-container text-3xl">
                  {category.icon || 'category'}
                </span>
              )}
            </div>
            <div class="flex-1 min-w-0 pr-14">
              <h3 class="text-xl font-display font-bold text-on-surface mb-1 truncate">
                {category.name}
              </h3>
              <p class="text-sm text-on-surface-variant line-clamp-2">
                {category.description || 'Sin descripción'}
              </p>
            </div>
          </div>
          
          <div class="flex items-center justify-between pt-4 border-t border-outline-variant mt-auto">
            <span class="inline-flex items-center gap-1 bg-surface-container-high px-2 py-1 rounded text-xs font-semibold text-on-surface-variant">
              <span class="material-symbols-outlined text-[14px]">sort</span>
              Orden: {category.order}
            </span>
            <span class="text-xs font-mono text-on-surface-variant bg-surface-container px-2 py-1 rounded select-all">
              {category.id}
            </span>
          </div>
        </div>
      ))}
    </div>

    {allCategories.length === 0 && (
      <div class="bg-surface rounded-2xl p-12 text-center border border-outline-variant mt-6">
        <span class="material-symbols-outlined text-on-surface-variant mb-4 block" style="font-size: 64px;">
          category
        </span>
        <p class="text-lg font-medium text-on-surface mb-2">
          No hay categorías registradas
        </p>
        <p class="text-on-surface-variant mb-6">
          Comienza creando la primera categoría para organizar tus productos.
        </p>
        <button 
          onclick="document.getElementById('modal-create').classList.remove('hidden')"
          class="bg-primary text-on-primary px-6 py-3 rounded-full font-bold inline-flex items-center gap-2 hover:scale-95 transition-all shadow-md"
        >
          <span class="material-symbols-outlined text-xl">add</span>
          Crear Primera Categoría
        </button>
      </div>
    )}

  </div>

  <!-- Create/Edit Modal -->
  <div id="modal-create" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-surface w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
      <div class="px-6 py-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low">
        <h3 class="text-xl font-bold text-on-surface" id="modal-title">Nueva Categoría</h3>
        <button 
          onclick="closeModal()"
          class="w-8 h-8 rounded-full hover:bg-surface-container-highest flex items-center justify-center text-on-surface-variant transition-colors"
        >
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      
      <form method="POST" class="p-6">
        <input type="hidden" name="action" id="form-action" value="create" />
        <input type="hidden" name="originalId" id="form-original-id" value="" />
        
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-bold text-on-surface mb-1">Nombre *</label>
              <input type="text" name="name" id="input-name" required class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all" oninput="if(document.getElementById('form-action').value === 'create') { document.getElementById('input-id').value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, ''); }" />
            </div>
            <div>
              <label class="block text-sm font-bold text-on-surface mb-1">ID (Slug) *</label>
              <input type="text" name="id" id="input-id" required pattern="[a-z0-9-]+" title="Solo letras minúsculas, números y guiones" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all font-mono text-sm" />
              <p class="text-[10px] text-on-surface-variant mt-1">Identificador único (ej: limpieza-hogar)</p>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-bold text-on-surface mb-1">Descripción</label>
            <textarea name="description" id="input-description" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all resize-none"></textarea>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-bold text-on-surface mb-1 flex items-center gap-1">
                Icono 
                <a href="https://fonts.google.com/icons?icon.set=Material+Symbols" target="_blank" class="text-primary hover:underline text-xs font-normal" title="Ver iconos">(Material Icons)</a>
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" id="icon-preview">category</span>
                <input type="text" name="icon" id="input-icon" value="category" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all" oninput="document.getElementById('icon-preview').textContent = this.value || 'category';" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-bold text-on-surface mb-1">Orden</label>
              <input type="number" name="order" id="input-order" value="0" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all" />
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-bold text-on-surface mb-1">URL de Imagen (Opcional)</label>
            <input type="url" name="image" id="input-image" placeholder="https://..." class="w-full px-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface outline-none transition-all" />
          </div>
        </div>
        
        <div class="mt-8 flex justify-end gap-3">
          <button type="button" onclick="closeModal()" class="px-6 py-2.5 rounded-full font-bold text-on-surface hover:bg-surface-container transition-colors">
            Cancelar
          </button>
          <button type="submit" class="bg-primary text-on-primary px-6 py-2.5 rounded-full font-bold hover:scale-95 transition-all shadow-md">
            Guardar Categoría
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function closeModal() {
      document.getElementById('modal-create').classList.add('hidden');
      // Reset form
      document.querySelector('form').reset();
      document.getElementById('form-action').value = 'create';
      document.getElementById('form-original-id').value = '';
      document.getElementById('modal-title').textContent = 'Nueva Categoría';
      document.getElementById('input-id').removeAttribute('readonly');
      document.getElementById('input-id').classList.remove('bg-surface-container-high', 'cursor-not-allowed');
      document.getElementById('icon-preview').textContent = 'category';
    }

    function openEditModal(category) {
      document.getElementById('modal-create').classList.remove('hidden');
      document.getElementById('form-action').value = 'update';
      document.getElementById('form-original-id').value = category.id;
      document.getElementById('modal-title').textContent = 'Editar Categoría';
      
      document.getElementById('input-name').value = category.name || '';
      document.getElementById('input-id').value = category.id || '';
      // Disable ID editing to prevent relationship breaking
      document.getElementById('input-id').setAttribute('readonly', 'true');
      document.getElementById('input-id').classList.add('bg-surface-container-high', 'cursor-not-allowed');
      
      document.getElementById('input-description').value = category.description || '';
      document.getElementById('input-icon').value = category.icon || 'category';
      document.getElementById('icon-preview').textContent = category.icon || 'category';
      document.getElementById('input-order').value = category.order || 0;
      document.getElementById('input-image').value = category.image || '';
    }
  </script>
</AdminLayout>
